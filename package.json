{
  "name": "bgsd",
  "private": true,
  "version": "0.5.32",
  "description": "Board Game Solutions Designer — visual editor for parametric OpenSCAD libraries",
  "author": "BGSD Contributors",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"electron . --disable-gpu --no-sandbox\"",
    "build": "vitest run && vite build",
    "start": "electron . --disable-gpu --no-sandbox",
    "harness": "node harness/run.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,svelte,json}\" \"*.{js,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "concurrently": "^9",
    "electron": "^33.4.11",
    "electron-builder": "^25",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.49",
    "prettier": "^3.8.1",
    "svelte": "^5.51.2",
    "vite": "^6",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.bgsd.app",
    "productName": "BGSD",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "importer.js",
      "build/icon*.png",
      "build/icon.ico",
      "build/icon.icns",
      "lib/**/*",
      "schema/**/*",
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
